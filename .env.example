# Backend API Configuration
API_URL="http://localhost:3000" # URL for backend API, used by frontend

# Media catalog service
# The catalog service (TMDB today) is configured from the app UI/CLI: values are
# stored in the backend's config.json and pushed to the service. The variables
# below are optional bootstrap fallbacks used only before the first push.
CATALOG_SERVICE_URL="http://localhost:3001" # Media catalog service URL (internal), used by the backend
TMDB_API_ACCESS_TOKEN="ey..." # Catalog provider API access token (optional env fallback for the media-catalog service)

# Trakt API credentials (optional)
TRAKT_CLIENT_ID="abcde"
TRAKT_CLIENT_SECRET="abcde"

# JWT signing secret (optional: generated on first start and saved in config.json)
JWT_SECRET="your-secure-secret-key"

# Security Configuration
REVERSE_PROXY_SECRET="your-secure-random-proxy-secret" # Secret shared between Caddy and backend
NORDVPN_PRIVATE_KEY="your-nordvpn-private-key" # NordVPN private key for WireGuard (optional)

# HTTPS with docker-compose.https.yml (Caddy gets the certificate)
MIAUFLIX_DOMAIN="" # miauflix.example.com

# Docker Configuration (for production deployment)
GITHUB_REPOSITORY="yourusername/miauflix"
MIAUFLIX_VERSION="latest"
