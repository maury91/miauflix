{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend (docker dev)",
      "url": "https://localhost:4173",
      "port": 4173
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:frontend"],
      "port": 4173,
      "url": "https://localhost:4173"
    },
    {
      "name": "frontend (my.miauflix.cat)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:frontend", "--", "--", "--port", "4175", "--strictPort"],
      "env": {
        "BACKEND_URL": "https://my.miauflix.cat"
      },
      "port": 4175,
      "url": "https://localhost:4175"
    },
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:backend"],
      "port": 3000
    },
    {
      "name": "media-catalog",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:catalog:watch"],
      "port": 3001
    },
    {
      "name": "list-service",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:list:watch"],
      "port": 3002
    },
    {
      "name": "storybook",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["-w", "frontend", "run", "storybook", "--", "--no-open"],
      "port": 6006
    },
    {
      "name": "tv-pairing",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "tv-pairing/src/index.ts"],
      "port": 3003
    }
  ]
}
