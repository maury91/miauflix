          "data": {
            "name": "Парадайс",
            "overview": "Тишината в спокойна, заможна общност, населена с едни от най-влиятелните личности в света, е разтърсена, когато се случва шокиращо убийство и започва разследване с високи залози.",
            "homepage": "",
            "tagline": ""
          }
        },
        {
          "iso_3166_1": "IR",
          "iso_639_1": "fa",
          "name": "فارسی",
          "english_name": "Persian",
          "data": {
            "name": "بهشت",
            "overview": "یک تیم خدمات امنیتی که وظیفه حفاظت از رئیس جمهور گذشته را بر عهده دارد",
            "homepage": "",
            "tagline": ""
          }
        },
        {
          "iso_3166_1": "SI",
          "iso_639_1": "sl",
          "name": "Slovenščina",
          "english_name": "Slovenian",
          "data": {
            "name": "Raj",
            "overview": "Ko se v mirni in bogati soseski, kjer živijo nekateri najvplivnejši ljudje na svetu zgodi pretresljiv umor nekdanjega predsednika, agent tajne službe sproži napeto preiskavo, pri kateri je veliko na kocki.",
            "homepage": "",
            "tagline": "Razberi skrito med lažmi."
          }
        },
        {
          "iso_3166_1": "VN",
          "iso_639_1": "vi",
          "name": "Tiếng Việt",
          "english_name": "Vietnamese",
          "data": {
            "name": "Thiên Đường",
            "overview": "Đặc vụ Xavier Collins phát hiện ra một trong những người quyền lực nhất thế giới đã bị giết hại dã man. Nhưng sau cái chết bí ẩn của tổng thống, anh nhận ra bản thân đang nằm trong một âm mưu đe dọa lớn lao, không chỉ ở sự an toàn của bản thân mà còn là nền tự do của cả thế giới.",
            "homepage": "",
            "tagline": ""
          }
        },
        {
          "iso_3166_1": "ES",
          "iso_639_1": "ca",
          "name": "Català",
          "english_name": "Catalan",
          "data": {
            "name": "",
            "overview": "Paradise està ambientada en una localitat tranquil·la entre els habitants de la qual es troben algunes de les persones més prominents del món. Però la calma dóna pas a la tempesta quan es comet un impactant assassinat i comença una delicada investigació.",
            "homepage": "",
            "tagline": "Llegeix entre mentides"
          }
        },
        {
          "iso_3166_1": "RS",
          "iso_639_1": "sr",
          "name": "Srpski",
          "english_name": "Serbian",
          "data": {
            "name": "Рај",
            "overview": "Када се догоди шокантно убиство бившег председника у мирном и богатом крају у којем живе неки од најутицајнијих људи на свету, агент Тајне службе покреће напету истрагу са високим улогом.",
            "homepage": "",
            "tagline": ""
          }
        },
        {
          "iso_3166_1": "LT",
          "iso_639_1": "lt",
          "name": "Lietuvių",
          "english_name": "Lithuanian",
          "data": {
            "name": "Rojus",
            "overview": "JAV prezidento apsaugai tai buvo tik dar viena diena darbe, kol komandos vadas nesurado nužudyto prezidento. Analizuojant nusikaltimo vietą, pamažu skleidžiasi sudėtingi agento Kolinso santykiai su auka.",
            "homepage": "",
            "tagline": ""
          }
        },
        {
          "iso_3166_1": "GE",
          "iso_639_1": "ka",
          "name": "ქართული",
          "english_name": "Georgian",
          "data": {
            "name": "სამოთხე",
            "overview": "მსოფლიოს ყველაზე გავლენიანი და მდიდარი ადამიანებით დასახლებული, მშვიდი და პრესტიჟული უბნის იდილია ერთ წამში ირღვევა, როდესაც იქ შემზარავი მკვლელობა ხდება. მომხდარს ფართომასშტაბიანი, მაღალი რისკის შემცველი გამოძიება მოჰყვება, რომელიც გავლენიანი საზოგადოების ყველაზე ბნელ საიდუმლოებებს ფარდას ჰხდის.",
            "homepage": "",
