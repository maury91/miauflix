            "homepage": "",
            "tagline": ""
          }
        },
        {
          "iso_3166_1": "HU",
          "iso_639_1": "hu",
          "name": "Magyar",
          "english_name": "Hungarian",
          "data": {
            "name": "Heated Rivalry - Forró viszály",
            "overview": "Két jégkorongozó éveken át tartó titkos románcba bonyolódik, miközben a dicsőséget hajszolják a jégen, és egymással – és az érzéseikkel – is küzdenek.",
            "homepage": "",
            "tagline": ""
          }
        },
        {
          "iso_3166_1": "DK",
          "iso_639_1": "da",
          "name": "Dansk",
          "english_name": "Danish",
          "data": {
            "name": "",
            "overview": "To hockeystjerner indleder et hemmeligt kærlighedsforhold, der står på flere i år, mens de jagter berømmelse og kæmper med kærligheden.",
