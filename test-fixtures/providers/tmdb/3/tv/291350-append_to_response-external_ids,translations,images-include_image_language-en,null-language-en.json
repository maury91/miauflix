        {
          "iso_3166_1": "HR",
          "iso_639_1": "hr",
          "name": "Hrvatski",
          "english_name": "Croatian",
          "data": {
            "name": "",
            "overview": "Anna Pigeon je bivša stanovnica grada koja je postala čuvarica nacionalnog parka nakon što je zbog razornog gubitka zauvijek promijenila smjer svog života. Dok Anna pokušava pobjeći od svojih demona, njezin se fokus usmjerava na rješavanje zločina počinjenih na područjima nacionalnih parkova, bez obzira na to tko ili što joj se nađe na putu.",
            "homepage": "",
            "tagline": ""
          }
        },
        {
          "iso_3166_1": "CZ",
          "iso_639_1": "cs",
          "name": "Český",
          "english_name": "Czech",
          "data": {
            "name": "",
            "overview": "Anna Pigeonová je bývalá měšťačka, která se stala strážkyní parku poté, co zničující ztráta navždy změnila směr jejího života. Zatímco se Anna snaží utéct svým démonům, zaměří se na řešení zločinů, k nimž došlo na území národního parku, bez ohledu na to, kdo nebo co jí stojí v cestě.",
            "homepage": "",
            "tagline": ""
          }
        },
        {
          "iso_3166_1": "RU",
          "iso_639_1": "ru",
          "name": "Pусский",
          "english_name": "Russian",
          "data": {
            "name": "Анна Пиджон",
            "overview": "Пережив личную трагедию, Анна отказалась от городской суеты и выбрала путь рейнджера в национальном парке. Но теперь, ей приходится сталкиваться с браконьерами и нелегальными добытчиками редких растений. Каждый новый случай - это вызов, требующий выдержки и смекалки.",
