        },
        {
          "iso_3166_1": "CN",
          "iso_639_1": "zh",
          "name": "普通话",
          "english_name": "Mandarin",
          "data": {
            "name": "叛徒：美版",
            "overview": "改编自荷兰原创电视真人秀节目《叛徒》。一群美国选手齐聚一处与世隔绝的庄园，参与一场充满欺骗与猜疑的心理博弈。他们通过团队挑战累积奖金，而隐藏其中的叛徒则暗中淘汰忠诚者，试图瞒过所有人并赢得奖金。忠诚者必须识破叛徒的身份，并在被逐一淘汰前将其驱逐出局。",
            "homepage": "",
            "tagline": ""
          }
        },
        {
          "iso_3166_1": "IL",
          "iso_639_1": "he",
          "name": "עִבְרִית",
          "english_name": "Hebrew",
          "data": {
            "name": "הבוגדים",
            "overview": "הגרסה האמריקנית של פרנצ’ייז ריאליטי-תחרותי שנולד במקור בהולנד. אותה מנחה אלן קאמינג והיא מאגדת בתוכה 20 מתמודדים, שמגיעים לטירה סקוטית עתיקה להתחרות על פרס כספי של רבע מיליון דולר.  על מנת לזכות בפרס הם צריכים לבצע משימות שונות ומגוונות, חלקן אקסטרימיות, משעשעות או מפחידות – כל משימה כזו מוסיפה סכום כסף לפרס הגדול שיוענק למי שיגיע לגמר. אלא שבדרך לשם הם יצטרכו למצוא מי מהם הם – הבוגדים.",
            "homepage": "",
            "tagline": ""
          }
        },
