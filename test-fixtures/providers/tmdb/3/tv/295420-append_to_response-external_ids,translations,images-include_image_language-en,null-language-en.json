        {
          "iso_3166_1": "VN",
          "iso_639_1": "vi",
          "name": "Tiếng Việt",
          "english_name": "Vietnamese",
          "data": {
            "name": "Chiếc mặt nạ đỏ son",
            "overview": "Người học việc làm mặt nạ Peru lẽ ra phải biết những hiểm nguy của The Masks. Bị Mặt nạ của Chiến thần nhập vào, cậu vô tình giết chết bạn bè và sư phụ của mình — Gaston Roux huyền thoại. Day dứt vì tội lỗi, Peru thề sẽ hủy diệt mọi chiếc mặt nạ mà sư phụ đã tạo ra trước khi bi kịch lặp lại. Khi sứ mệnh đưa cậu đi khắp thế giới, Peru kết bạn, chiến đấu với kẻ thù và đối mặt với tội lỗi của chính mình.",
            "homepage": "",
            "tagline": ""
          }
        },
        {
          "iso_3166_1": "TH",
          "iso_639_1": "th",
          "name": "ภาษาไทย",
