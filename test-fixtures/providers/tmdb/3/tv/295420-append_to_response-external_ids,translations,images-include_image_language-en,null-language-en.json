        {
          "iso_3166_1": "US",
          "iso_639_1": "en",
          "name": "English",
          "english_name": "English",
          "data": {
            "name": "The Vermilion Mask",
            "overview": "Apprentice mask maker Peru should have known the perils of The Masks. Possessed by the Mask of the Warrior God, he unintentionally kills his friends and his master, the legendary Gaston Roux. Wracked with guilt, Peru vows to destroy every mask his master created before tragedy strikes again. As his mission takes him around the world, Peru makes friends, battles enemies, and reckons with his sins.",
            "homepage": "",
            "tagline": ""
          }
        },
        {
          "iso_3166_1": "DE",
          "iso_639_1": "de",
          "name": "Deutsch",
          "english_name": "German",
          "data": {
            "name": "The Vermilion Mask",
