            "tagline": "ขอต้อนรับสู่เกาะ ขอให้สนุกกับการพักผ่อนที่นี่ แต่อย่าถามอะไรมากเกินไปก็พอ"
          }
        },
        {
          "iso_3166_1": "TR",
          "iso_639_1": "tr",
          "name": "Türkçe",
          "english_name": "Turkish",
          "data": {
            "name": "",
            "overview": "Bir New England kasabasının belediye başkanı, yerel halkın lanetli olduğuna dair uyarılarına rağmen orayı yeni turizm merkezi yapmaya kararlı.",
            "homepage": "",
            "tagline": ""
          }
        },
        {
          "iso_3166_1": "SI",
          "iso_639_1": "sl",
          "name": "Slovenščina",
          "english_name": "Slovenian",
          "data": {
            "name": "",
            "overview": "Župan iz Nove Anglije želi pospešiti turizem na svojem otoku kljub krajevnim opozorilom, da je preklet.",
            "homepage": "",
            "tagline": ""
          }
        },
        {
          "iso_3166_1": "SE",
          "iso_639_1": "sv",
          "name": "svenska",
          "english_name": "Swedish",
          "data": {
            "name": "",
            "overview": "En borgmästare i New England vill göra sin stad till nästa stora turistort, trots lokala varningar om att den är fördömd.",
            "homepage": "",
            "tagline": "Välkommen till ön, vi hoppas att du trivs här. Men ställ inte för många frågor."
          }
        },
        {
          "iso_3166_1": "VN",
          "iso_639_1": "vi",
          "name": "Tiếng Việt",
          "english_name": "Vietnamese",
          "data": {
            "name": "Bí Ẩn Thị Trấn Widow's Bay",
            "overview": "Một thị trưởng ở một thị trấn thuộc New England muốn du lịch hóa nơi này, dù người dân địa phương cảnh báo hòn đảo bị nguyền rủa.",
            "homepage": "",
            "tagline": "Chào mừng đến với hòn đảo, chúc bạn có một kỳ nghỉ thật vui. Nhưng đừng tò mò quá làm gì!"
          }
        },
        {
          "iso_3166_1": "UA",
          "iso_639_1": "uk",
          "name": "Український",
          "english_name": "Ukrainian",
          "data": {
            "name": "Відоус-Бей",
            "overview": "Мер містечка в Новій Англії має намір перетворити його на туристичну принаду, попри застереження місцевих про те, що це місце прокляте.",
            "homepage": "",
            "tagline": "Вітаємо на острові. Почувайтеся як удома. Головне — без зайвих запитань."
          }
        },
        {
          "iso_3166_1": "CN",
          "iso_639_1": "zh",
          "name": "普通话",
          "english_name": "Mandarin",
          "data": {
            "name": "寡妇湾",
            "overview": "新英格兰小岛寡妇湾长期流传着关于诅咒的传说。市长汤姆·洛夫蒂斯试图将小岛打造为旅游胜地，却在游客涌入后接连遭遇一系列诡异事件。随着事态不断失控，笼罩小岛的神秘传说逐渐成为现实。",
            "homepage": "",
            "tagline": ""
          }
        },
        {
          "iso_3166_1": "BG",
          "iso_639_1": "bg",
          "name": "български език",
          "english_name": "Bulgarian",
          "data": {
            "name": "Заливът на вдовицата",
            "overview": "Кметът на малък град в Ню Ингланд иска да го превърне в туристически хит, но местните предупреждават: градът е прокълнат.",
            "homepage": "",
            "tagline": ""
          }
        },
        {
          "iso_3166_1": "IR",
          "iso_639_1": "fa",
          "name": "فارسی",
          "english_name": "Persian",
          "data": {
            "name": "خلیج بیوه ها",
            "overview": "شهردار شهری در نیوانگلند، علیرغم هشدارهای محلی مبنی بر نفرین شدن آن، تصمیم می‌گیرد آن را به مقصد گردشگری بعدی تبدیل کند.",
            "homepage": "",
            "tagline": ""
          }
        },
        {
          "iso_3166_1": "LT",
