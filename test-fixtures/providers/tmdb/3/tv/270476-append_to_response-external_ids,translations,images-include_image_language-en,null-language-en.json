          "name": "Lietuvių",
          "english_name": "Lithuanian",
          "data": {
            "name": "Našlių įlanka",
            "overview": "Naujosios Anglijos miestelio meras nusprendžia paversti jį nauju turistų traukos objektu, nepaisydamas vietinių gyventojų perspėjimų, kad jis prakeiktas.",
            "homepage": "",
            "tagline": ""
          }
        },
        {
          "iso_3166_1": "RS",
          "iso_639_1": "sr",
          "name": "Srpski",
          "english_name": "Serbian",
          "data": {
            "name": "Удовичин Залив",
            "overview": "Градоначелник једног града у Новој Енглеској одлучује да га претвори у следећу туристичку атракцију, упркос упозорењима локалног становништва да је проклет.",
            "homepage": "",
            "tagline": ""
          }
        },
        {
