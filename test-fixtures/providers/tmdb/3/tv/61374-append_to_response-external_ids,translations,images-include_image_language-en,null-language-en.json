        {
          "iso_3166_1": "PL",
          "iso_639_1": "pl",
          "name": "Polski",
          "english_name": "Polish",
          "data": {
            "name": "Tokyo Ghoul",
            "overview": "Tokio zostaje nawiedzone przez żądne krwi ghule, które wyglądem przypominają ludzi. Jeden z nich próbuje łączyć życie zwykłego śmiertelnika ze swoją drugą naturą.",
            "homepage": "",
            "tagline": ""
          }
        },
        {
          "iso_3166_1": "TH",
          "iso_639_1": "th",
          "name": "ภาษาไทย",
          "english_name": "Thai",
          "data": {
            "name": "ผีปอบโตเกียว",
            "overview": "ชาวโตเกียวต้องอยู่อย่างหวาดผวาเมื่อพวกกูลแฝงตัวอยู่กับคนปกติและกินเนื้อสดจากซากศพเป็นอาหาร เคน คาเนกิจะทำอย่างไรเมื่อพบว่าตนคือครึ่งคนครึ่งกูลที่ติดอยู่ระหว่างสองโลก",
            "homepage": "",
            "tagline": ""
          }
        },
        {
          "iso_3166_1": "HU",
          "iso_639_1": "hu",
          "name": "Magyar",
          "english_name": "Hungarian",
          "data": {
            "name": "Tokyo Ghoul",
            "overview": "A Tokyo Ghoul egy olyan anime, melyben a szörnyeteg ghoulok felfalják a tokiói polgárokat. A főiskolás Kaneki egy kávézóban találkozik egy csinos lánnyal, aki hasonló szenvedéllyel viseltetik az irodalom iránt, mint ő. Egy baleset következtében a fiú különös hibriddé változott, s a félig ghoul, félig ember Kaneki mások megmentésének szentelte életét, ám a lánnyal való találkozása felborította ezen elhatározásában.",
            "homepage": "",
            "tagline": ""
          }
        },
