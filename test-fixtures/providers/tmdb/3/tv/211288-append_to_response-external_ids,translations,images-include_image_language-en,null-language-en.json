        {
          "iso_3166_1": "IR",
          "iso_639_1": "fa",
          "name": "فارسی",
          "english_name": "Persian",
          "data": {
            "name": "ردیاب",
            "overview": "کولتر شاو، یک بقاگرای تنهارو، به عنوان یک «جستجوگرِ پاداش» در سراسر کشور پرسه می‌زند و با استفاده از مهارت‌های ردیابی حرفه‌ای خود، به شهروندان و نیروهای قانون در حل انواع معماها کمک می‌کند، در حالی که همزمان با خانواده از هم پاشیده‌ خود نیز دست‌و‌پنجه نرم می‌کند.",
            "homepage": "",
            "tagline": "ما همه به‌دنبال چیزی هستیم."
