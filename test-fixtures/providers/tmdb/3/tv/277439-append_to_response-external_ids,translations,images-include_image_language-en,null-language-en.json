          "data": {
            "name": "Рт страха",
            "overview": "По изласку из затвора, осуђени убица Макс Кејди полако се увлачи у живот породице адвокатског пара који га је својевремено послао иза решетака.",
            "homepage": "",
            "tagline": ""
          }
        },
