        },
        {
          "iso_3166_1": "VN",
          "iso_639_1": "vi",
          "name": "Tiếng Việt",
          "english_name": "Vietnamese",
          "data": {
            "name": "Thế Giới Rác",
            "overview": "Rudo sống cùng cha nuôi Regto tại khu ổ chuột, căm ghét sự xa hoa và phung phí của tầng lớp thượng lưu. Một ngày nọ, anh phát hiện Regto bị sát hại và ngay lập tức bị buộc tội giết người, rồi bị ném xuống Địa Ngục - nơi chôn vùi tất cả những gì mà xã hội coi là rác rưởi. Tưởng chừng phải bỏ mạng, Rudo sống sót và tỉnh dậy giữa một thế giới kỳ dị đầy quái vật được tạo nên từ rác. Được một chiến binh bí ẩn mang tên Enjin cứu giúp, Rudo phát hiện ra sức mạnh mới cùng trách nhiệm tiêu diệt quái vật của mình. Mang theo nỗi căm phẫn và khát khao phục thù, cậu bắt đầu hành trình lội ngược dòng từ đáy vực tối tăm để giành lại công lý và sự thật.",
            "homepage": "",
            "tagline": ""
          }
