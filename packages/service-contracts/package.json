{
  "name": "@miauflix/service-contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./catalog/v1": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:ts": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@miauflix/contract": "*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
