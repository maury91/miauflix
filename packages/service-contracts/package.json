{
  "name": "@miauwatch/service-contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./catalog/v1": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    },
    "./card-image/v1": {
      "types": "./dist/card-image.d.ts",
      "default": "./dist/card-image.js"
    },
    "./profiles/v1": {
      "types": "./dist/profiles.d.ts",
      "default": "./dist/profiles.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:ts": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@miauwatch/contract": "*",
    "@miauwatch/source-metadata-extractor": "*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
