{
  "name": "@miauflix/therarbg-sanitizer",
  "version": "1.0.0",
  "description": "A shared library for sanitizing TheRARBG API data across Miauflix projects",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint .",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "clean": "rm -rf dist coverage",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "therarbg",
    "sanitizer",
    "testing",
    "miauflix",
    "torrent",
    "fake-data"
  ],
  "author": "Miauflix Team",
  "license": "MIT",
  "dependencies": {
    "@faker-js/faker": "10.1.0",
    "@miauflix/source-metadata-extractor": "*"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "ts-jest": "29.4.5"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.test.ts",
      "!src/**/*.d.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": {
            "module": "ESNext"
          }
        }
      ]
    }
  }
}
