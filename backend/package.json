{
  "name": "@miauflix/backend",
  "version": "1.0.0",
  "main": "src/app.ts",
  "types": "./dist/client/index.d.ts",
  "scripts": {
    "start": "bun --env-file=../.env src/app.ts",
    "start:prod": "bun --env-file=../.env src/app.ts",
    "dev": "bun --watch --env-file=../.env src/app.ts",
    "config": "npm start -- --config",
    "config-only": "npm start -- --only-config",
    "build:client": "mkdir -p dist/client && dts-bundle-generator --project tsconfig.client.json ./src/client.ts -o dist/client/index.d.ts --external-imports hono --no-check && tsc --project tsconfig.client.json && mv dist/client/client.js dist/client/index.js && test -f dist/client/index.js",
    "check:ts": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "bun test --isolate"
  },
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    }
  },
  "peerDependencies": {
    "hono": "4.13.18"
  },
  "dependencies": {
    "@hono/otel": "1.0.1",
    "@hono/zod-validator": "0.7.4",
    "@inquirer/prompts": "7.8.2",
    "@keyv/sqlite": "4.0.6",
    "@miauflix/contract": "*",
    "@miauflix/service-configuration": "*",
    "@miauflix/service-contracts": "*",
    "@miauflix/source-metadata-extractor": "*",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.67.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.212.0",
    "@opentelemetry/resources": "2.2.0",
    "@opentelemetry/sdk-metrics": "2.2.0",
    "@opentelemetry/sdk-node": "0.208.0",
    "@opentelemetry/sdk-trace-node": "2.2.0",
    "@opentelemetry/semantic-conventions": "1.38.0",
    "bunqueue-client": "0.1.9",
    "cache-manager": "7.2.9",
    "cacheable": "2.5.0",
    "chalk": "5.6.0",
    "debug": "4.4.3",
    "dotenv": "17.2.3",
    "jose": "6.1.2",
    "keyv": "5.6.0",
    "node-fetch": "3.3.2",
    "node-html-parser": "^7.0.1",
    "parse-torrent": "11.0.18",
    "reflect-metadata": "0.2.2",
    "sqlite3": "5.1.7",
    "streamx": "2.22.1",
    "typeorm": "0.3.31",
    "uuid": "13.0.0",
    "whatwg-url": "14.2.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@faker-js/faker": "10.1.0",
    "@sinonjs/fake-timers": "13.0.5",
    "@types/debug": "4.1.12",
    "@types/jest": "30.0.0",
    "@types/sinonjs__fake-timers": "15.0.1",
    "@types/streamx": "2.9.5",
    "bun-types": "^1.4.0",
    "dts-bundle-generator": "9.5.1"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  }
}
